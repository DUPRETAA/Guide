<Window x:Class="guid_add.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:guid_add"
        mc:Ignorable="d"
        Title="Добавление достопримечательностей" Height="304" Width="617" ResizeMode="NoResize">
    <Window.Resources>
        <DataTemplate x:Key="templ">
            <TextBlock Text="{Binding title}" TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate x:Key="templ2">
            <TextBlock Text="{Binding description}" TextWrapping="Wrap" />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <TabControl>
            <TabItem Header="Добавление">
                <Grid Background="#FFE5E5E5">
                    <Button x:Name="submit" Content="Подтвердить" HorizontalAlignment="Left" Margin="246,218,0,0" Width="120" VerticalAlignment="Top" Click="submit_Click"/>
                    <TextBox x:Name="title" HorizontalAlignment="Center" Margin="0,7,0,0" TextWrapping="Wrap" Text="Название" VerticalAlignment="Top" Width="591" GotKeyboardFocus="title_GotKeyboardFocus" LostKeyboardFocus="title_LostKeyboardFocus"/>
                    <TextBox x:Name="description" Margin="0,30,0,0" TextWrapping="Wrap" Text="Описание" VerticalAlignment="Top" Height="159" HorizontalAlignment="Center" Width="591" GotKeyboardFocus="description_GotKeyboardFocus" LostKeyboardFocus="description_LostKeyboardFocus"/>
                    <Button Content="Добавить фото" Margin="466,194,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="120" Click="Button_Click_1"/>
                    <TextBox x:Name="latitude" HorizontalAlignment="Left" Margin="11,194,0,0" TextWrapping="Wrap" Text="Широта" VerticalAlignment="Top" Width="120" Height="19" GotKeyboardFocus="latitude_GotKeyboardFocus" LostKeyboardFocus="latitude_LostKeyboardFocus"/>
                    <TextBox x:Name="longitude" HorizontalAlignment="Left" Margin="136,194,0,0" TextWrapping="Wrap" Text="Долгота" VerticalAlignment="Top" Width="120" Height="19" GotKeyboardFocus="longitude_GotKeyboardFocus" LostKeyboardFocus="longitude_LostKeyboardFocus"/>
                </Grid>
            </TabItem>
            <TabItem Header="Удаление">
                <Grid Background="#FFE5E5E5">
                    <DataGrid x:Name="sights" d:ItemsSource="{d:SampleData ItemCount=5}" Height="184" VerticalAlignment="Top" AutoGeneratingColumn="DataGrid_AutoGeneratingColumn" Loaded="sights_Loaded" CanUserAddRows="False" CanUserDeleteRows="False"/>
                    <Button Content="Удалить" HorizontalAlignment="Center" Margin="0,189,0,0" VerticalAlignment="Top" Width="106" Click="Button_Click"/>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
